FAB_WDATA21, NPU_PSUM_PORT0_BASE_TO_TOP21
FAB_WDATA22, NPU_PSUM_PORT0_BASE_TO_TOP22
FAB_WDATA23, NPU_PSUM_PORT0_BASE_TO_TOP23
FAB_WDATA24, NPU_PSUM_PORT0_BASE_TO_TOP24
FAB_WDATA25, NPU_PSUM_PORT0_BASE_TO_TOP25
FAB_WDATA26, NPU_PSUM_PORT0_BASE_TO_TOP26
FAB_WDATA27, NPU_PSUM_PORT0_BASE_TO_TOP27
