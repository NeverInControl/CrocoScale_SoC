FAB_WDATA31, NPU_PSUM_PORT0_BASE_TO_TOP31

# subtile 1 gives address, write enables and the read bank select
FAB_ADDR0  , NPU_PSUM_PORT1_BASE_TO_TOP0
FAB_ADDR1  , NPU_PSUM_PORT1_BASE_TO_TOP1
FAB_ADDR2  , NPU_PSUM_PORT1_BASE_TO_TOP2
