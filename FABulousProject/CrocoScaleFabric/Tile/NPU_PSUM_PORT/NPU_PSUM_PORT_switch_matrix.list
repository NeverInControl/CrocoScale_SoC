FAB_WDATA8 , NPU_PSUM_PORT0_BASE_TO_TOP8
FAB_WDATA9 , NPU_PSUM_PORT0_BASE_TO_TOP9
FAB_WDATA10, NPU_PSUM_PORT0_BASE_TO_TOP10
FAB_WDATA11, NPU_PSUM_PORT0_BASE_TO_TOP11
FAB_WDATA12, NPU_PSUM_PORT0_BASE_TO_TOP12
