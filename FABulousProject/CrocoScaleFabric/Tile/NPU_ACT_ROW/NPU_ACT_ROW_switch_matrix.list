S2BEG[5|5|5|5] , [J_NS2_END5|E2MID2|E2END2|E1END 1]
S2BEG[6|6|6|6] , [J_NS2_END6|E2MID1|E2END1|E1END 2]
S2BEG[7|7|7|7] , [J_NS2_END7|E2MID0|E2END0|E1END 3]


J_NS1_BEG[0|0|0|0] , [N1END0|S1END0|E6END0|GND0]
