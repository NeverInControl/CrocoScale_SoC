# we use Jump wires in order to reuse the signals that go to the BRAM for vertical routing
FAB2RAM_D0_I[0|0|0|0] , [J_NS4_END 0 |WW4END 0|WW4END 8 |W6END 0]
FAB2RAM_D0_I[1|1|1|1] , [J_NS4_END 1 |WW4END 1|WW4END 9 |W6END 1]
