# RAM_IO_W

# double with MID cascade : [N,S]2BEG --- [N,S]2MID -> [N,S]2BEGb --- [N,S]2END (just routing)
[N|S]2BEGb[0|1|2|3|4|5|6|7], [N|S]2MID[0|1|2|3|4|5|6|7]



J_NS4_BEG[ 0| 0| 0| 0] , [N4END0|S4END0|N1END0|S1END0]
